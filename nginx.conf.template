worker_processes auto;

events {
    worker_connections 1024;
}

http {
    resolver ${DNS_RESOLVER} valid=30s;
    resolver_timeout 5s;

    upstream owlery {
        server ${UPSTREAM_SERVER};
        keepalive 16;
    }

    log_format cache '$remote_addr - $remote_user [$time_local] "$request" '
                        '$status $body_bytes_sent "$http_referer" '
                        '"$http_user_agent" "$http_x_forwarded_for" '
                        '$upstream_cache_status $request_time $upstream_response_time';

    access_log /dev/stdout cache;
    error_log /dev/stderr warn;

    proxy_cache_path /var/cache/nginx/owlery levels=1:2 keys_zone=owlery_cache:100m max_size=${CACHE_MAX_SIZE} inactive=5d use_temp_path=off;

    proxy_cache_key "$request_method$request_uri";
    proxy_cache_min_uses 1;
    proxy_cache_revalidate on;
    proxy_cache_methods GET HEAD;

    proxy_cache_valid 200 5d;
    proxy_cache_valid 404 30s;
    proxy_cache_valid 500 30s;
    proxy_cache_valid 502 30s;
    proxy_cache_valid 503 30s;
    proxy_cache_valid 504 30s;

    proxy_cache_use_stale updating;
    proxy_cache_background_update on;
    proxy_cache_lock on;

    server {
        listen 80;

        location /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }

        location /blog/ {
            return 301 https://virtualflybrain.org$request_uri;
        }

        location / {
            proxy_pass http://owlery$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_connect_timeout 900s;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            # proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_timeout 30s;
            proxy_next_upstream_tries 2;
            add_header X-Cache-Status $upstream_cache_status;
            add_header X-Cache-Key "$request_method$request_uri";
            proxy_ignore_headers Cache-Control Expires Set-Cookie;
            proxy_cache owlery_cache;
        }
    }

    server {
        listen 8080;

        location /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }

        location /blog/ {
            return 301 https://virtualflybrain.org$request_uri;
        }

        location / {
            proxy_pass http://owlery$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_connect_timeout 900s;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            # proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_timeout 30s;
            proxy_next_upstream_tries 2;
            add_header X-Cache-Status $upstream_cache_status;
            add_header X-Cache-Key "$request_method$request_uri";
            proxy_ignore_headers Cache-Control Expires Set-Cookie;
            proxy_cache owlery_cache;
        }
    }
}
